---
import { localePath, pick, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<article class="wrap flex min-h-[60vh] flex-col justify-center py-24">
  <p class="eyebrow">404</p>
  <h1 class="mt-5 text-[clamp(2.25rem,5vw,4rem)] leading-[1.2]">{pick(locale, 'ページが見つかりません', 'Page not found')}</h1>
  <p class="lede mt-6 max-w-xl">
    {pick(locale,
      'お探しのページは、移動されたか、削除された可能性があります。URLをご確認のうえ、以下からお進みください。',
      'The page you are looking for may have moved or been removed. Please check the address, or use the links below.')}
  </p>
  <nav aria-label={pick(locale, '404ページからのリンク', 'Links from the 404 page')} class="mt-12 flex flex-wrap gap-x-8 gap-y-4 text-[0.9375rem]">
    <a href={localePath(locale, '/')} class="btn-primary">{pick(locale, 'トップページへ', 'Go to the home page')}</a>
    <a href={localePath(locale, '/contact/')} class="btn-quiet">{pick(locale, 'お問い合わせ', 'Contact')}</a>
    <a href={localePath(locale, '/property/')} class="btn-quiet">{pick(locale, '物件情報', 'Properties')}</a>
  </nav>
</article>
