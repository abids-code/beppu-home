---
import Base from '../../../layouts/Base.astro';
import ServicePage from '../../../views/ServicePage.astro';
import { serviceFor } from '../../../content/services';
import { pageMeta } from '../../../lib/meta';

const locale = 'en' as const;
const meta = pageMeta('sell', locale);
---
<Base locale={locale} path="/buy/" title={meta.title} description={meta.description} motion={true}>
  <ServicePage locale={locale} service={serviceFor('sell', locale)} />
</Base>
