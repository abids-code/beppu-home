---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import { company } from '../lib/site';
import { defaultLocale, localePath, locales, type Locale, pick } from '../lib/i18n';
import socialImage from '../assets/photos/13_1_1.jpg';
import fontsUrl from '../styles/fonts.css?url';

interface Props {
  title: string;
  description: string;
  // Path without locale prefix, e.g. "/buy/". Used for canonical and hreflang.
  path: string;
  locale: Locale;
  motion?: boolean;
  noindex?: boolean;
}

const { title, description, path, locale, motion = false, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(locale, path), siteUrl).href;
const alternates = locales.map((loc) => ({
  hreflang: loc === 'ja' ? 'ja-JP' : 'en-US',
  href: new URL(localePath(loc, path), siteUrl).href,
}));
const xDefault = new URL(localePath(defaultLocale, path), siteUrl).href;
const brand = pick(locale, company.brandJa, company.brandEn);
const pageTitle = title.includes(brand) ? title : `${title} | ${brand}`;
const socialImageUrl = new URL(socialImage.src, siteUrl).href;
---
<!doctype html>
<html lang={locale === 'en' ? 'en' : 'ja'} class={locale === 'en' ? 'en' : 'ja'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ja_JP'} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#f4f1eb" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <!-- Webfonts load without blocking first paint; the system font shows until they arrive. -->
    <link rel="preload" href={fontsUrl} as="style" />
    <link rel="stylesheet" href={fontsUrl} media="print" data-async-css />
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>
    <slot name="head" />
  </head>
  <body data-motion={motion ? 'on' : 'off'}>
    <a class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper" href="#main">
      {pick(locale, '本文へ移動', 'Skip to content')}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ContactBar locale={locale} />
    <script>
      // Switch the non-blocking font stylesheet to "all" once it is requested (see the <noscript> fallback in <head>).
      document.querySelectorAll<HTMLLinkElement>('link[data-async-css]').forEach((link) => {
        // The stylesheet may already have loaded before this script runs, so check for it first.
        if (link.sheet) link.media = 'all';
        else link.addEventListener('load', () => { link.media = 'all'; });
      });
    </script>
    <script>
      // Reveal markers exist on most pages, so the (small) reveal module loads everywhere.
      import('../scripts/motion');
    </script>
  </body>
</html>
