---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  // Fixed crops keep layouts stable (see docs/design-research.md, section 5).
  ratio?: '16/10' | '4/5' | '4/3' | '1/1' | '3/2' | '21/9';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  ratio = '3/2',
  sizes = '(min-width: 64rem) 50vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---
<figure class:list={['m-0', className]}>
  <div class="relative overflow-hidden bg-hairline" style={`aspect-ratio: ${ratio};`}>
    <Image
      src={src}
      alt={alt}
      sizes={sizes}
      widths={[480, 720, 960, 1280, 1600]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
  {caption && <figcaption class="mt-3 text-xs leading-relaxed text-stone">{caption}</figcaption>}
</figure>
