---
// Native <details> keeps the FAQ usable without JavaScript and keyboard-accessible.
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  id?: string;
}

const { items, id = 'faq' } = Astro.props;
---
<div id={id} class="divide-y divide-hairline border-y border-hairline">
  {items.map((item, i) => (
    <details class="faq-item group" open={i === 0}>
      <summary class="flex min-h-12 cursor-pointer list-none items-start justify-between gap-6 py-6 font-display text-[1.1875rem] leading-relaxed md:text-xl">
        <span class="flex-1">{item.q}</span>
        <span aria-hidden="true" class="faq-icon mt-1 inline-block w-4 shrink-0 text-center text-2xl leading-none transition-transform duration-300">+</span>
      </summary>
      <div class="prose-body max-w-3xl pb-7 pr-10 text-[0.9375rem] leading-[1.9] text-ink/85">
        <p set:html={item.a} />
      </div>
    </details>
  ))}
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>
