---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  level?: 'h1' | 'h2';
  id?: string;
  class?: string;
}

const { eyebrow, title, lede, level = 'h2', id, class: className } = Astro.props;
const Tag = level;
---
<header class:list={['max-w-3xl', className]}>
  {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
  <Tag id={id} class:list={[
    'mt-4 text-balance',
    level === 'h1' ? 'text-[clamp(2.25rem,5.2vw,4.25rem)]' : 'text-[clamp(1.75rem,3.4vw,2.75rem)]',
  ]} data-reveal>{title}</Tag>
  {lede && <p class="lede mt-6 max-w-2xl text-pretty" data-reveal>{lede}</p>}
</header>
